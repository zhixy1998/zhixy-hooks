{
  "root": true, // 标记为根配置（避免被父目录的 tsconfig 覆盖）
  "compilerOptions": {
    //类型检查规则
    "target": "ES5",
    "moduleResolution": "node", //使用 Node.js 的模块解析策略（对标 require() 的查找逻辑）
    "jsx": "react", //将 .tsx 文件编译为 React JSX 代码
    // "esModuleInterop": true, //允许 CommonJS 模块像 ES 模块一样导入（解决 import React from 'react' 报错）
    "downlevelIteration": true, //降级迭代器语法（确保 for...of 在 ES5 中正确运行）
    "sourceMap": true, //生成 .map 文件（方便调试）
    "baseUrl": ".",
    "paths": {
      //路径映射
      "@/*": ["src/*"],
      "encodeHooks": ["./packages/hooks/src/index.ts"],
      "encode-hooks": ["./packages/hooks/src/index.ts"],
      "encodeHooks/lib/*": ["./packages/hooks/src/*"],
      "encode-hooks/lib/*": ["./packages/hooks/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "importHelpers": true //从 tslib 导入辅助函数（减少重复代码）
  },
  "exclude": ["node_modules", "lib", "es", "dist", "example"] //排除的目录
}
